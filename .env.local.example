# Copy this file to ".env.local" in the frontend/ root and fill in real values.
# Next.js auto-loads .env.local at build/dev time. Never commit the real .env.local file.

# URL of the Zenko Spring Boot backend
NEXT_PUBLIC_API_URL=http://localhost:8080

# NOTE: Actual transactional emails (welcome, order confirmation, order status update,
# contact form) are sent SERVER-SIDE by the Spring Boot backend via the EmailJS REST API
# (see backend/.env.example). The frontend does not need EmailJS keys for those flows.
