# ── Copy this file to ".env" in the backend/ root folder and fill in real values ──
# The backend auto-loads ".env" at startup via spring-dotenv. Never commit the real .env file.

# ---- Server ----
SERVER_PORT=8080
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- MySQL Database ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zenko_ecom
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DDL_AUTO=update
SHOW_SQL=false

# ---- JWT ----
JWT_SECRET=change-this-to-a-long-random-256-bit-secret-in-production
JWT_EXPIRATION_MS=86400000
JWT_ADMIN_EXPIRATION_MS=43200000

# ---- File uploads ----
UPLOAD_DIR=uploads/products

# ---- EmailJS (https://dashboard.emailjs.com) ----
# Set EMAILJS_ENABLED=true only after creating a service + templates on emailjs.com
EMAILJS_ENABLED=false
EMAILJS_API_URL=https://api.emailjs.com/api/v1.0/email/send
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
# Private key is required for SERVER-SIDE (non-browser) calls to EmailJS.
# Dashboard > Account > Security > "Private Key"
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
ADMIN_NOTIFY_EMAIL=admin@zenko.com

# Template IDs — create these 5 templates in EmailJS dashboard (HTML given separately)
EMAILJS_TEMPLATE_WELCOME=template_welcome
EMAILJS_TEMPLATE_ORDER_CONFIRMATION=template_order_confirm
EMAILJS_TEMPLATE_ORDER_STATUS=template_order_status
EMAILJS_TEMPLATE_CONTACT=template_contact
# Used by the "Forgot Password" flow — template must include a {{reset_link}} variable
EMAILJS_TEMPLATE_PASSWORD_RESET=template_password_reset
